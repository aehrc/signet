{
  "name": "signet",
  "private": true,
  "type": "module",
  "description": "Multi-tenant SMART on FHIR authorization server",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "check:bundle": "bun run --filter @signet/server build && node scripts/checkBundle.mjs apps/server/dist/index.js",
    "check:chart": "node scripts/checkChartCredentials.mjs",
    "dev": "bun run --filter '*' dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:duplication": "bunx jscpd",
    "lint:fix": "eslint . --fix",
    "stack:down": "docker compose -f deploy/compose/docker-compose.yml down",
    "stack:logs": "docker compose -f deploy/compose/docker-compose.yml logs -f",
    "stack:seed": "bun scripts/seedStack.mjs",
    "stack:seed:fhir": "bun scripts/seedFhir.mjs",
    "stack:up": "docker compose -f deploy/compose/docker-compose.yml up -d --build --wait",
    "test": "bun test src/ --timeout 120000",
    "test:coverage": "bun test src/ --coverage --timeout 120000 && node scripts/checkCoverage.mjs",
    "test:e2e": "bun run --filter signet-e2e test",
    "test:watch": "bun test src/ --watch --timeout 120000",
    "typecheck": "tsc --build --force"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unicorn": "^65.0.1",
    "jscpd": "^5.0.14",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
