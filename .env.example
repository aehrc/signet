# Public origin Signet is reached on. Endpoint issuers are derived from it as
# {SIGNET_PUBLIC_URL}/t/{tenant}/e/{endpoint}, so changing it invalidates every
# issuer already published to FHIR servers and registered clients.
SIGNET_PUBLIC_URL=http://localhost:3000

# Either a full connection URL...
SIGNET_DATABASE_URL=postgres://signet:signet@localhost:5432/signet

# ...or discrete parts, which is what the Helm chart uses with the bundled
# PostgreSQL subchart so it never has to invent a password. Set one or the
# other, not both.
# SIGNET_DATABASE_HOST=localhost
# SIGNET_DATABASE_PORT=5432
# SIGNET_DATABASE_NAME=signet
# SIGNET_DATABASE_USER=signet
# SIGNET_DATABASE_PASSWORD=signet

# Envelope key that encrypts endpoint signing keys at rest. At least 32
# characters. Losing this makes every stored signing key undecryptable, so back
# it up somewhere other than the database it protects.
SIGNET_MASTER_KEY=change-me-0123456789abcdef0123456789abcdef

# Directory holding the built UI. Set in the container image; leave unset in
# development, where Vite serves the UI and proxies /api to this server.
# SIGNET_WEB_ROOT=/app/web

# Turns off the outbound-fetch guard, permitting private addresses and plain HTTP
# when Signet fetches a client's jwks_uri or an upstream IdP's discovery document.
# Needed only for a development or connectathon stack whose IdP is on a compose
# network. Never set this in production: an authorization server with an SSRF sits
# inside the network holding the FHIR servers it fronts.
# SIGNET_ALLOW_PRIVATE_OUTBOUND_FETCHES=false

PORT=3000
SIGNET_LOG_LEVEL=info
