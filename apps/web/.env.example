# What the console's Vite dev server reads. Copy into `.env.local`.
#
# Vite loads `.env` files from this directory, which is where
# `bun run --filter @signet/web dev` runs it. Nothing here reaches the browser
# bundle: only the dev server's own configuration reads it.

# The Signet server that `/api` and `/t` are proxied to. Match it to `PORT` in
# `apps/server/.env.local`. Defaults to http://localhost:3000.
SIGNET_SERVER_URL=http://localhost:3000

# The port the console is served on. Defaults to 5173, and the dev server refuses
# to start rather than move to another port when it is taken. Match it to
# `SIGNET_PUBLIC_URL` in `apps/server/.env.local`: the browser reaches the server
# through this origin, and passkey ceremonies are verified against that URL.
SIGNET_CONSOLE_PORT=5173
