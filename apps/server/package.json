{
  "name": "@signet/server",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Signet OAuth endpoints and admin API",
  "main": "./src/index.ts",
  "scripts": {
    "build": "bun build src/index.ts --target=node --outdir=dist --sourcemap=linked",
    "dev": "bun --watch src/index.ts",
    "migrate": "bun src/index.ts migrate",
    "start": "node dist/index.js",
    "sweep": "bun src/index.ts sweep",
    "test": "bun test src/ --timeout 120000"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@signet/contracts": "workspace:*",
    "@signet/core": "workspace:*",
    "@signet/db": "workspace:*",
    "@simplewebauthn/server": "^13.3.2",
    "hono": "^4.13.18",
    "jose": "^6.2.7",
    "undici": "^8.12.4",
    "zod": "^4.4.3"
  }
}
